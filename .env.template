# Server port
PORT=3000

# Optional: custom temporary working directory for download jobs
# DOWNLOADER_TMP_DIR=/tmp/youtube-downloader

# Optional: completed download file retention window in minutes
DOWNLOAD_FILE_TTL_MINUTES=10

# Optional: automatic yt-dlp browser-cookie fallback (examples: chrome, firefox:default)
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Local-only binding; set 0.0.0.0 explicitly for intended external access
HOST=127.0.0.1

# Per-process job, queue, metadata and storage reservation limits
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=8
MAX_RETAINED_JOBS=32
MAX_JOB_BYTES=536870912
MAX_STORAGE_BYTES=8589934592
JOB_TIMEOUT_MS=1800000
CREATION_RATE_LIMIT=10
